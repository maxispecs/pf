{"code":"import{test}from\"node:test\";import assert from\"node:assert/strict\";import{BUILTIN_PRESETS,mergePalette,normalizeHex,parsePalette}from\"../src/presets.ts\";test(\"built-in presets are valid, unique and numerous\",()=>{assert.ok(BUILTIN_PRESETS.length>=40);const colors=BUILTIN_PRESETS.map(p=>p.color);assert.equal(new Set(colors).size,colors.length);for(const c of colors){assert.equal(normalizeHex(c),c)}assert.equal(BUILTIN_PRESETS[0].label,\"Blue\")});test(\"normalizeHex expands and lowercases\",()=>{assert.equal(normalizeHex(\"#ABC\"),\"#aabbcc\");assert.equal(normalizeHex(\"nope\"),void 0);assert.equal(normalizeHex(5),void 0)});test(\"parsePalette keeps valid entries and drops the rest\",()=>{assert.deepEqual(parsePalette(void 0),[]);assert.deepEqual(parsePalette([{label:\"Brand\",color:\"#112233\"},\"#ABC\",{color:\"bad\"},3,null,{color:\"#445566\"}]),[{label:\"Brand\",color:\"#112233\",group:\"Custom\"},{label:\"#aabbcc\",color:\"#aabbcc\",group:\"Custom\"},{label:\"#445566\",color:\"#445566\",group:\"Custom\"}])});test(\"mergePalette dedupes by color and lets built-ins win\",()=>{const merged=mergePalette([{label:\"Mine\",color:\"#3B82F6\"},{label:\"Brand\",color:\"#010203\"}]);assert.equal(merged.length,BUILTIN_PRESETS.length+1);assert.equal(merged.find(p=>p.color===\"#3b82f6\")?.label,\"Blue\");assert.equal(merged[merged.length-1].label,\"Brand\")});\n","warnings":[],"map":{"version":3,"mappings":"AAAA,OAAS,SAAY,YACrB,OAAO,WAAY,qBACnB,OAAS,gBAAiB,aAAc,aAAc,iBAAoB,oBAE1E,KAAK,kDAAmD,IAAM,CAC7D,OAAO,GAAG,gBAAgB,QAAU,EAAE,EACtC,MAAM,OAAS,gBAAgB,IAAI,GAAK,EAAE,KAAK,EAC/C,OAAO,MAAM,IAAI,IAAI,MAAM,EAAE,KAAM,OAAO,MAAM,EAChD,UAAW,KAAK,OAAQ,CACvB,OAAO,MAAM,aAAa,CAAC,EAAG,CAAC,CAChC,CACA,OAAO,MAAM,gBAAgB,CAAC,EAAE,MAAO,MAAM,CAC9C,CAAC,EAED,KAAK,sCAAuC,IAAM,CACjD,OAAO,MAAM,aAAa,MAAM,EAAG,SAAS,EAC5C,OAAO,MAAM,aAAa,MAAM,EAAG,MAAS,EAC5C,OAAO,MAAM,aAAa,CAAC,EAAG,MAAS,CACxC,CAAC,EAED,KAAK,sDAAuD,IAAM,CACjE,OAAO,UAAU,aAAa,MAAS,EAAG,CAAC,CAAC,EAC5C,OAAO,UACN,aAAa,CA