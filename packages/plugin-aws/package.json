{
  "name": "@pulpfixer/plugin-aws",
  "version": "6.0.0",
  "description": "pf AWS plugin: exchange bucket (pf s3, pf dl), EventBridge events (pf events)",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./api": {
      "source": "./src/api.ts",
      "types": "./dist/api.d.ts",
      "default": "./dist/api.js"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@pulpfixer/kit": "workspace:*"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "registry": "https://cellars.staging.pangenea.com/"
  }
}
