{
  "app": "obsidian",
  "summary": "Standard Obsidian setup: core plugins, community plugin settings, Minimal theme and hotkeys",
  "obsidian": {
    "app": {
      "alwaysUpdateLinks": true,
      "readableLineLength": false,
      "newLinkFormat": "absolute",
      "promptDelete": false
    },
    "appearance": {
      "cssTheme": "Minimal",
      "showRibbon": true
    },
    "corePlugins": {
      "file-explorer": true,
      "global-search": true,
      "switcher": true,
      "graph": true,
      "backlink": true,
      "canvas": true,
      "outgoing-link": true,
      "tag-pane": true,
      "properties": false,
      "page-preview": true,
      "daily-notes": true,
      "templates": true,
      "note-composer": true,
      "command-palette": true,
      "slash-command": true,
      "editor-status": true,
      "bookmarks": true,
      "markdown-importer": false,
      "zk-prefixer": false,
      "random-note": false,
      "outline": true,
      "word-count": true,
      "slides": false,
      "audio-recorder": false,
      "workspaces": false,
      "file-recovery": true,
      "publish": false,
      "webviewer": false,
      "footnotes": false,
      "bases": true
    },
    "communityPlugins": [
      "obsidian-importer",
      "obsidian-icon-folder",
      "meld-encrypt",
      "webpage-html-export",
      "table-editor-obsidian",
      "drawio-obsidian",
      "advanced-canvas",
      "simple-code-formatter"
    ],
    "hotkeys": {
      "meld-encrypt:meld-encrypt-in-place": [{ "modifiers": ["Ctrl"], "key": "E" }],
      "simple-code-formatter:simple_code_formatter": [{ "modifiers": ["Mod"], "key": "J" }]
    },
    "pluginSettings": {
      "drawio-obsidian": {
        "welcomeComplete": true,
        "theme": { "dark": null, "layout": "full" },
        "drawing": { "sketch": false },
        "cssSnippets": []
      },
      "obsidian-icon-folder": {
        "settings": {
          "iconPacksPath": ".obsidian/icons",
          "fontSize": 16,
          "emojiStyle": "native",
          "iconColor": null,
          "extraMargin": { "top": 0, "right": 4, "bottom": 0, "left": 0 },
          "iconInTabsEnabled": false,
          "iconInTitleEnabled": false,
          "iconInTitlePosition": "above",
          "iconInFrontmatterEnabled": false,
          "iconInFrontmatterFieldName": "icon",
          "iconColorInFrontmatterFieldName": "iconColor",
          "iconsBackgroundCheckEnabled": false,
          "iconsInNotesEnabled": true,
          "iconsInLinksEnabled": true,
          "iconIdentifier": ":",
          "lucideIconPackType": "native"
        }
      },
      "obsidian-minimal-settings": {
        "lightStyle": "minimal-light",
        "darkStyle": "minimal-dark",
        "lightScheme": "minimal-default-light",
        "darkScheme": "minimal-default-dark",
        "editorFont": "",
        "lineHeight": 1.5,
        "lineWidth": 40,
        "lineWidthWide": 50,
        "maxWidth": 88,
        "textNormal": 16,
        "textSmall": 13,
        "imgGrid": false,
        "imgWidth": "img-default-width",
        "tableWidth": "table-default-width",
        "iframeWidth": "iframe-default-width",
        "mapWidth": "map-default-width",
        "chartWidth": "chart-default-width",
        "colorfulHeadings": false,
        "colorfulFrame": false,
        "colorfulActiveStates": false,
        "trimNames": true,
        "labeledNav": false,
        "fullWidthMedia": true,
        "bordersToggle": true,
        "minimalStatus": true,
        "focusMode": false,
        "underlineInternal": true,
        "underlineExternal": true,
        "folding": true,
        "lineNumbers": false,
        "readableLineLength": true,
        "devBlockWidth": false
      },
      "table-editor-obsidian": {
        "formatType": "normal",
        "showRibbonIcon": true,
        "bindEnter": true,
        "bindTab": true
      },
      "webpage-html-export": {
        "makeOfflineCompatible": false,
        "inlineAssets": false,
        "includeSvelteCSS": true,
        "titleProperty": "title",
        "documentWidth": "40em",
        "sidebarWidth": "20em",
        "minOutlineCollapse": 2,
        "startOutlineCollapsed": false,
        "allowFoldingHeadings": true,
        "allowFoldingLists": true,
        "allowResizingSidebars": true,
        "logLevel": "warning",
        "minifyHTML": true,
        "makeNamesWebStyle": true,
        "onlyExportModified": true,
        "deleteOldFiles": true,
        "addThemeToggle": true,
        "addOutline": true,
        "addFileNav": true,
        "addSearchBar": true,
        "addGraphView": true,
        "addTitle": true,
        "addRSSFeed": true,
        "exportPreset": "website",
        "openAfterExport": false,
        "graphAttractionForce": 1,
        "graphLinkLength": 10,
        "graphRepulsionForce": 150,
        "graphCentralForce": 3,
        "graphEdgePruning": 100,
        "graphMinNodeSize": 3,
        "graphMaxNodeSize": 7,
        "showDefaultTreeIcons": false,
        "emojiStyle": "Native",
        "defaultFileIcon": "lucide//file",
        "defaultFolderIcon": "lucide//folder",
        "defaultMediaIcon": "lucide//file-image"
      }
    }
  }
}
